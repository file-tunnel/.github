{
  "schema_version": 1,
  "organization": "file-tunnel",
  "canonical_profile_repository": "file-tunnel/.github",
  "conflict_resolution": {
    "mode": "semantic",
    "blanket_ours_or_theirs": false,
    "inspect_history_and_tests": true
  },
  "repository_consolidation": {
    "preserve_history": true,
    "prefer_short_canonical_names": true,
    "require_deprecation_pointer": true
  },
  "validation": {
    "exact_head": true,
    "live_target_ancestry": true,
    "strict_branch_freshness_required": true,
    "zero_step_ci_is_failure": true,
    "post_merge_exact_tree_validation": true,
    "truthful_evidence": true,
    "carrier_fallback": {
      "exact_tree_sha_required": true,
      "cross_org_checkout_tokens": false,
      "source_secrets_forbidden": true
    }
  }
}
